            {
              "name": "Restore original Git objects and verify every observed source ref",
              "run": "python3 - <<'PY'\nimport hashlib,json,subprocess,tempfile\nfrom pathlib import Path\ndata=json.loads(Path('source-consolidation.json').read_text())\ncount=0\nfor component in data['components']:\n    archive=component.get('history_archive')\n    if archive is None:\n        continue\n    bundle=Path(archive['path']).resolve()\n    assert hashlib.sha256(bundle.read_bytes()).hexdigest()==archive['sha256']\n    with tempfile.TemporaryDirectory() as folder:\n        subprocess.run(['git','init','--bare','--quiet',folder],check=True)\n        subprocess.run(['git','-C',folder,'fetch','--quiet',str(bundle),'+refs/heads/*:refs/heads/*','+refs/tags/*:refs/tags/*','+refs/pull/*:refs/pull/*'],check=True)\n        subprocess.run(['git','-C',folder,'cat-file','-e',component['source_head']+'^{commit}'],check=True)\n        for reference in archive['observed_source_refs'] + archive.get('observed_source_pull_refs', []):\n            ref=reference['ref']\n            if ref.startswith('refs/heads/'):\n                ref=ref.replace('refs/heads/','refs/heads/source/',1)\n            actual=subprocess.check_output(['git','-C',folder,'rev-parse',ref],text=True).strip()\n            assert actual==reference['sha'], reference['ref']\n    count+=1\nassert count>0\nprint(f'Restored {count} source histories and all recorded refs')\nPY\n",
